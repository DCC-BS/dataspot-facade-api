# Dataspot access key used by the /v1/auth endpoint to authenticate and issue JWTs
MY_DATASPOT_TOKEN=

# Secret key for signing JWT tokens (required)
JWT_SECRET=

# Base URL of the Dataspot instance (required)
BASE_URL=https://datenkatalog.bs.ch

# Base path this API is served under, e.g. /fade-api when the reverse proxy
# exposes it at https://example.com/fade-api. Leave empty to serve at the root.
# Set ROOT_PATH instead if the proxy strips the prefix and you do not run
# uvicorn with --root-path (BASE_PATH is used as ROOT_PATH by default).
BASE_PATH=

# Database name in Dataspot (required)
DATABASE_NAME=wonderfull

# Set to "true" for production mode (disables local CORS origins)
IS_PROD=false

# Dataspot service user access key (used by backend services)
DATASPOT_SERVICE_USER_ACCESS_KEY=

# Azure AD / Entra ID configuration (for Dataspot client credentials)
DATASPOT_TENANT_ID=
DATASPOT_CLIENT_ID=
DATASPOT_CLIENT_SECRET=
DATASPOT_EXPOSED_CLIENT_ID=

# Rustrak (self-hosted, Sentry-compatible error tracking)
# ---------------------------------------------------------------------------
# Sentry-compatible DSN for this FastAPI app. Find it in Rustrak after logging
# into the dashboard and creating a project, e.g. http://<key>@localhost:8080/1
RUSTRAK_DSN=
# Minimum level forwarded to Rustrak Logs (DEBUG/INFO/WARNING/ERROR, default INFO)
RUSTRAK_LOG_LEVEL=INFO
# Records at or above this level also become dashboard issues (default ERROR)
RUSTRAK_EVENT_LEVEL=ERROR
# Set to "true" to enable extra debug log lines in this app
RUSTRAK_DEBUG=false

# --- compose.yml ---
# Public URL SDKs should use for their DSN, e.g. https://rustrak.example.com.
# The Rustrak dashboard is served from the root of its origin and cannot run
# under a sub-path, so give it its own hostname (or serve it at / on the
# same host and put this API under its own path via BASE_PATH).
RUSTRAK_PUBLIC_URL=
# Port the Rustrak dashboard/API is exposed on (default 8080)
RUSTRAK_PORT=8080
# Rustrak log verbosity (info / debug / warn / error)
RUSTRAK_LOG=info
# Session secret. Generate with: openssl rand -hex 32
RUSTRAK_SESSION_SECRET_KEY=
# First admin user, format email:password
RUSTRAK_SUPERUSER=admin@example.com:changeme123